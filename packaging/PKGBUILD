pkgname=monkeytype-tui
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, minimalist terminal typing test with Kitty cursor trail support, ASCII animations, and DMS theme sync"
arch=('x86_64')
url="https://github.com/bhavyam2468/monkeytype-tui"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')

build() {
  cd "$startdir/.."
  cargo build --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 "target/release/monkeytype-tui" "$pkgdir/usr/bin/monkeytype-tui"
  install -Dm644 "packaging/monkeytype-tui.desktop" "$pkgdir/usr/share/applications/monkeytype-tui.desktop"
  install -Dm644 "assets/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/monkeytype-tui.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
